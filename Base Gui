-- Ember Ripple Helper Effect
local function FlameRipple(btn)
	task.spawn(function()
		local ripple = Instance.new("Frame")
		ripple.BackgroundColor3 = Themes.Accent
		ripple.BackgroundTransparency = 0.5
		ripple.BorderSizePixel = 0
		ripple.AnchorPoint = Vector2.new(0.5, 0.5)
		
		local mouse = UserInputService:GetMouseLocation()
		local relPos = mouse - btn.AbsolutePosition
		ripple.Position = UDim2.new(0, relPos.X, 0, relPos.Y - 36)
		ripple.Size = UDim2.new(0, 0, 0, 0)
		ripple.Parent = btn
		
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = ripple
		
		local tween = TweenService:Create(ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 220, 0, 220),
			BackgroundTransparency = 1
		})
		tween:Play()
		tween.Completed:Wait()
		ripple:Destroy()
	end)
end

-- Draggable Window Helper
local function MakeDraggable(dragFrame, parentFrame)
	local dragging, dragInput, dragStart, startPos
	dragFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = parentFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			TweenService:Create(parentFrame, TweenInfo.new(0.05), {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			}):Play()
		end
	end)
end

