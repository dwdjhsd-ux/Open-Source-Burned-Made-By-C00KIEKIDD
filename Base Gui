function Burned:CreateWindow(title)
	local WindowTable = { CurrentTab = nil }

	if TargetGui:FindFirstChild("Burned_Lava_UI") then
		TargetGui.Burned_Lava_UI:Destroy()
	end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "Burned_Lava_UI"
	ScreenGui.Parent = TargetGui
	ScreenGui.ResetOnSpawn = false

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Size = UDim2.new(0, 560, 0, 420)
	MainFrame.Position = UDim2.new(0.5, -280, 0.5, -210)
	MainFrame.BackgroundColor3 = Themes.Secondary
	MainFrame.BorderSizePixel = 0
	MainFrame.ClipsDescendants = true
	MainFrame.Parent = ScreenGui

	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0, 10)
	MainCorner.Parent = MainFrame

	local MainStroke = Instance.new("UIStroke")
	MainStroke.Color = Themes.Primary
	MainStroke.Thickness = 2
	MainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	MainStroke.Parent = MainFrame

	-- Pulsing Border Loop
	task.spawn(function()
		while MainStroke and MainStroke.Parent do
			TweenService:Create(MainStroke, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Themes.Accent}):Play()
			task.wait(1.2)
			TweenService:Create(MainStroke, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Color = Themes.Primary}):Play()
			task.wait(1.2)
		end
	end)

	local TopBar = Instance.new("Frame")
	TopBar.Name = "TopBar"
	TopBar.Size = UDim2.new(1, 0, 0, 42)
	TopBar.BackgroundColor3 = Themes.Container
	TopBar.BorderSizePixel = 0
	TopBar.Parent = MainFrame

	MakeDraggable(TopBar, MainFrame)

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1, -50, 1, 0)
	TitleLabel.Position = UDim2.new(0, 15, 0, 0)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = " " .. (title or "BURNED V1")
	TitleLabel.TextColor3 = Themes.Accent
	TitleLabel.TextSize = 15
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Parent = TopBar

	local LavaLine = Instance.new("Frame")
	LavaLine.Size = UDim2.new(1, 0, 0, 2)
	LavaLine.Position = UDim2.new(0, 0, 1, -2)
	LavaLine.BackgroundColor3 = Themes.Primary
	LavaLine.BorderSizePixel = 0
	LavaLine.Parent = TopBar

	local Sidebar = Instance.new("ScrollingFrame")
	Sidebar.Name = "Sidebar"
	Sidebar.Size = UDim2.new(0, 150, 1, -42)
	Sidebar.Position = UDim2.new(0, 0, 0, 42)
	Sidebar.BackgroundColor3 = Themes.Container
	Sidebar.BorderSizePixel = 0
	Sidebar.ScrollBarThickness = 0
	Sidebar.Parent = MainFrame

	local SidebarLayout = Instance.new("UIListLayout")
	SidebarLayout.Padding = UDim.new(0, 6)
	SidebarLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	SidebarLayout.Parent = Sidebar

	local SidebarPadding = Instance.new("UIPadding")
	SidebarPadding.PaddingTop = UDim.new(0, 12)
	SidebarPadding.Parent = Sidebar

	local ContainerHolder = Instance.new("Frame")
	ContainerHolder.Name = "ContainerHolder"
	ContainerHolder.Size = UDim2.new(1, -150, 1, -42)
	ContainerHolder.Position = UDim2.new(0, 150, 0, 42)
	ContainerHolder.BackgroundTransparency = 1
	ContainerHolder.Parent = MainFrame

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.RightControl then
			MainFrame.Visible = not MainFrame.Visible
		end
	end)

	WindowTable.ContainerHolder = ContainerHolder
	WindowTable.Sidebar = Sidebar
	WindowTable.MainFrame = MainFrame

	setmetatable(WindowTable, Burned)
	return WindowTable
end

-- -----------------------------------------------------------------
-- TAB CREATOR
-- -----------------------------------------------------------------
function Burned:CreateTab(name)
	local TabTable = { Window = self }

	local TabButton = Instance.new("TextButton")
	TabButton.Size = UDim2.new(0, 130, 0, 34)
	TabButton.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	TabButton.Text = name
	TabButton.TextColor3 = Themes.TextSub
	TabButton.Font = Enum.Font.GothamSemibold
	TabButton.TextSize = 12
	TabButton.BorderSizePixel = 0
	TabButton.Parent = self.Sidebar

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0, 6)
	ButtonCorner.Parent = TabButton

	local Indicator = Instance.new("Frame")
	Indicator.Size = UDim2.new(0, 3, 0, 0)
	Indicator.Position = UDim2.new(0, 0, 0.5, 0)
	Indicator.AnchorPoint = Vector2.new(0, 0.5)
	Indicator.BackgroundColor3 = Themes.Primary
	Indicator.BorderSizePixel = 0
	Indicator.Parent = TabButton

	local ElementsContainer = Instance.new("ScrollingFrame")
	ElementsContainer.Name = name .. "_Container"
	ElementsContainer.Size = UDim2.new(1, 0, 1, 0)
	ElementsContainer.BackgroundTransparency = 1
	ElementsContainer.BorderSizePixel = 0
	ElementsContainer.Visible = false
	ElementsContainer.ScrollBarThickness = 3
	ElementsContainer.ScrollBarImageColor3 = Themes.Primary
	ElementsContainer.Parent = self.ContainerHolder

	local ElementsLayout = Instance.new("UIListLayout")
	ElementsLayout.Padding = UDim.new(0, 8)
	ElementsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	ElementsLayout.Parent = ElementsContainer

	local ElementsPadding = Instance.new("UIPadding")
	ElementsPadding.PaddingTop = UDim.new(0, 12)
	ElementsPadding.Parent = ElementsContainer

	TabButton.MouseButton1Click:Connect(function()
		FlameRipple(TabButton)
		if self.CurrentTab then
			self.CurrentTab.ElementsContainer.Visible = false
			TweenService:Create(self.CurrentTab.TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 20, 20), TextColor3 = Themes.TextSub}):Play()
			TweenService:Create(self.CurrentTab.Indicator, TweenInfo.new(0.2), {Size = UDim2.new(0, 3, 0, 0)}):Play()
		end

		ElementsContainer.Visible = true
		TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 25, 22), TextColor3 = Themes.Accent}):Play()
		TweenService:Create(Indicator, TweenInfo.new(0.2), {Size = UDim2.new(0, 3, 0, 20)}):Play()
		self.CurrentTab = TabTable
	end)

	if not self.CurrentTab then
		ElementsContainer.Visible = true
		TabButton.BackgroundColor3 = Color3.fromRGB(45, 25, 22)
		TabButton.TextColor3 = Themes.Accent
		Indicator.Size = UDim2.new(0, 3, 0, 20)
		self.CurrentTab = TabTable
	end

	TabTable.ElementsContainer = ElementsContainer
	TabTable.TabButton = TabButton
	TabTable.Indicator = Indicator
	return setmetatable(TabTable, { __index = Burned })
end

